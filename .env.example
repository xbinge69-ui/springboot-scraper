# Environment variables for the scraper. Copy this file to `.env`,
# fill in the real values, and export each line before running the app:
#
#   cp .env.example .env
#   set -a; source .env; set +a
#   ./mvnw spring-boot:run
#
# This file is committed as a template. The real `.env` is listed in
# `.gitignore` and must never be committed.

# --- Required for real Bunny CDN uploads ---
# Get this from https://panel.bunny.net → Storage → your zone → FTP & API access.
BUNNY_STORAGE_API_KEY=

# --- Optional: regional Bunny edge (e.g. "ny", "la", "sg") ---
# Uncomment to use a regional storage edge. Default edge is the global
# https://storage.bunnycdn.com.
# BUNNY_STORAGE_REGION=

# --- Optional overrides ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=mistral

# --- Required for auto-propagation of batch results to project-b ---
# Get this from https://console.anthropic.com → Settings → API Keys.
# Without this key, app.add-video-entry.enabled has no effect — the
# propagation service will log a warning at startup and propagation
# jobs will fail at runtime.
#
# In practice, on this dev machine the key is already in the OS
# environment (same place project-b's Claude session reads it from),
# so you usually don't need to set it here. This block is documented
# for completeness — the bean reads ${ANTHROPIC_API_KEY:} from the
# OS env at startup, with application-local.properties as a fallback.
#
# The key is never logged, never persisted, and never returned in
# error messages.
ANTHROPIC_API_KEY=
