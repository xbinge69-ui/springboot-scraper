# Environment variables for the scraper. Copy this file to `.env`,
# fill in the real values, and export each line before running the app:
#
#   cp .env.example .env
#   set -a; source .env; set +a
#   ./mvnw spring-boot:run
#
# This file is committed as a template. The real `.env` is listed in
# `.gitignore` and must never be committed.

# --- Required for real Bunny CDN uploads ---
# Get this from https://panel.bunny.net → Storage → your zone → FTP & API access.
BUNNY_STORAGE_API_KEY=

# --- Optional: regional Bunny edge (e.g. "ny", "la", "sg") ---
# Uncomment to use a regional storage edge. Default edge is the global
# https://storage.bunnycdn.com.
# BUNNY_STORAGE_REGION=

# --- Optional overrides ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=mistral
